# =============================================================================
# HARD RULE: this working tree is ~686 GB / 1.6M files. NEVER `git add .`
# without this file in place. It excludes all data, containers, caches, cores,
# checkpoints, and raw results; you stage source/scripts explicitly.
# =============================================================================

# ── SLURM job logs ───────────────────────────────────────────────────────────
logs/**/*.out
logs/**/*.err
logs/**/*.log
!logs/**/.gitkeep

# Stray logs / SLURM output anywhere
*.out
*.err
*.log

# ── Core dumps (gpucore.* = ~433 GB) ─────────────────────────────────────────
core.*
*.core
gpucore.*

# ── NCCL/RCCL bootstrap handshake files ──────────────────────────────────────
nccl_id_*
.energy_chain_ids.txt

# ── Build trees ──────────────────────────────────────────────────────────────
.build*/
build/
build-*/
build_*/
**/build/
__pycache__/
*.pyc

# ── MIOpen kernel-DB caches (one dir per job) ────────────────────────────────
.miopen_*/
.container_tmp/

# ── Containers / disk images (multi-GB binaries) ─────────────────────────────
*.sif
*.img
*.simg

# ── Datasets (symlinked or materialized ImageNet, Tiny-ImageNet, val sets) ───
ImageNet-1K/
imagenet/
imagenet_subset_*/
.imagenet_valset/
tiny-imagenet-200/
*.zip
*.tar
*.tar.gz
*.tgz

# ── Model checkpoints / weights ──────────────────────────────────────────────
checkpoints/
*.bin
*.pt
*.pth
*.ckpt

# ── Vendored third-party clones (fetch these separately, don't vendor) ───────
DeepLearningExamples/
MIVisionX/
rccl-tests/
rocal_sandbox/

# ── Raw experiment results / profiles (regenerated by re-running) ────────────
profiles/
profile*/
scaling_logs_*/
scaling_results_*.csv
rocal_build_logs_*/
benchmark_results/
smoke_test_results/
build_check_results/
ncu_comparison_latest/
imagenet_results/
_archive/
power_analysis/results/
plot_bundle/**/*.png
plots/
figures/

# ── Isolated per-job test dirs ───────────────────────────────────────────────
bf16ar_test_*/
flip_test_*/
mpbf16_test_*/
nhwc_test_*/

# ── Local agent/tooling state (do not publish) ───────────────────────────────
.claude/
